config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DK Godot v0.5.03 - STREAMING SPATIAL BUCKET INDEX FOUNDATION BUILD"
config/version="0.5.03"
run/main_scene="res://scenes/tests/SeamlessCellStreamingTest.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

DKFaith="*res://scripts/progression/DKFaith.gd"
SaveManager="*res://addons/savekit/save_manager.gd"
DKSaveManager="*res://scripts/save/DKSaveManager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/dk_door_linker/plugin.cfg", "res://addons/dk_live_builder/plugin.cfg", "res://addons/theme_gen_save_sync/plugin.cfg", "res://addons/savekit/plugin.cfg", "res://addons/dk_project_diagnostics/plugin.cfg", "res://addons/dk_editor_startup_2d/plugin.cfg", "res://addons/dk_manual_placement_protection/plugin.cfg")

